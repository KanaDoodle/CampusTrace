+		{"section_and_bonus", "任职要求：熟悉Go；C++经验优先", []string{"REQUIRED:go", "c++"}},
+		{"responsibilities", "工作职责：使用Go编写服务", []string{"go"}},
+		{"not_required", "无需Go经验", nil},
