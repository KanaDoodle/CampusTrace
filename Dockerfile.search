ARG GO_IMAGE=golang:1.25.9-bookworm
FROM ${GO_IMAGE} AS build
WORKDIR /src
ENV GOWORK=off CGO_ENABLED=0
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/search ./cmd/search
COPY internal/searchapi ./internal/searchapi
COPY internal/searchservice ./internal/searchservice
COPY internal/observability ./internal/observability
RUN go build -trimpath -o /out/search ./cmd/search
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/search /app/search
USER 65532:65532
WORKDIR /app
CMD ["/app/search"]
