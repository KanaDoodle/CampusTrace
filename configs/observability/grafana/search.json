{
  "uid": "campustrace-search",
  "title": "CampusTrace · Search",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "CampusTrace"
  ],
  "timezone": "Asia/Shanghai",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Search 请求 / 秒",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "campustrace-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(campustrace_search_requests_total[5m])",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Search 请求 P95（秒）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "campustrace-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(campustrace_search_request_seconds_bucket[5m])))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Search 错误 / 秒",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "campustrace-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(campustrace_search_errors_total[5m])",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "待同步岗位",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "campustrace-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "campustrace_search_pending",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "索引已追平",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "campustrace-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "campustrace_search_ready",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "完整搜索与基础回退 / 秒",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "campustrace-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(__name__) (rate({__name__=~\"campustrace_search_(fulltext|basic)_total\"}[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "同步岗位 / 秒",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "campustrace-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(campustrace_search_documents_synced_total[5m])",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "同步错误 / 秒",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "campustrace-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(campustrace_search_sync_errors_total[5m])",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Search 存活",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "campustrace-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"campustrace-search\"}",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}