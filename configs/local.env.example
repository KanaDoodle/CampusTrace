# Local development only. Generate a different secret for non-demo use.
JWT_SECRET=local-campus-demo-secret-change-me-2027
MYSQL_DSN=campus:local-campus-only@tcp(127.0.0.1:13306)/campustrace?parseTime=true&loc=UTC
REDIS_ADDR=127.0.0.1:16379
ETCD_ENDPOINTS=127.0.0.1:12379
HTTP_ADDR=127.0.0.1:8080
WORKER_CONCURRENCY=4
ANALYSIS_CONCURRENCY=2
LLM_CONCURRENCY=2
EMBEDDING_CONCURRENCY=2
# Optional OpenAI-compatible chat endpoint, no real API call by default.
# LLM_URL=https://your-provider.example/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=
# If changing extraction method/model/prompt, change the version on all workers.
ANALYSIS_VERSION=claims-v2-semantics
# Each analysis instance needs a separate local health listener.
ANALYSIS_HEALTH_ADDR=127.0.0.1:19191
AGENT_MAX_MODEL_CALLS=4
AGENT_MAX_TOOL_CALLS=8
AGENT_DEADLINE_SECONDS=35
AGENT_TOOL_TIMEOUT_SECONDS=8
WORKER_METRICS_ADDR=127.0.0.1:18081
# Full deterministic ranking configuration (JSON; every weight is required):
# RANKING_WEIGHTS={"status":30,"eligibility":30,"city":10,"type":5,"go_fit":10,"role":10,"freshness":5}
