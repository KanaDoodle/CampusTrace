# Local development only. Generate a different secret for non-demo use.
JWT_SECRET=local-campus-demo-secret-change-me-2027
MYSQL_DSN=campus:local-campus-only@tcp(127.0.0.1:13306)/campustrace?parseTime=true&loc=UTC
REDIS_ADDR=127.0.0.1:16379
ETCD_ENDPOINTS=127.0.0.1:12379
HTTP_ADDR=127.0.0.1:8080
WORKER_CONCURRENCY=4
# Typed mode uses independent executors per type; WORKER_CONCURRENCY is legacy only.
TASK_QUEUE_MODE=typed
QUEUE_CAPACITY=256
QUEUE_OWNER_CAPACITY=32
WORKER_ANALYZE_CONCURRENCY=2
WORKER_ASSESS_CONCURRENCY=1
WORKER_WATCH_CHECK_CONCURRENCY=1
WORKER_WATCH_FETCH_CONCURRENCY=2
WORKER_SOURCE_IMPORT_CONCURRENCY=1
# SYSTEM_<TYPE> pools default to one each. All pools together must be <=64.
MATCH_QUEUE_WAIT_SECONDS=30
MATCH_EXECUTION_SECONDS=175
# All API instances must agree on this authoritative matching pool policy.
# Counts are attempted model requests, not tokens or money. Review never retries.
MATCH_GLOBAL_CAPACITY=2
MATCH_GLOBAL_QUEUE=64
MATCH_GLOBAL_OWNER_QUEUE=1
MATCH_GLOBAL_DAILY_CALLS=400

# Optional observability; make observability supplies the local Tempo endpoint.
# Empty endpoint keeps OTLP export disabled during ordinary startup.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
CAMPUS_GRAFANA_PORT=13000
CAMPUS_PROMETHEUS_PORT=19090
CAMPUS_TEMPO_PORT=13200
# Acknowledged task stream history only; unread/pending tasks are always retained.
# Valid hours: 1..8760. Business records, retries and DLQ are not pruned here.
TASK_HISTORY_HOURS=24
ANALYSIS_CONCURRENCY=2
LLM_CONCURRENCY=2
EMBEDDING_CONCURRENCY=2
# Optional OpenAI-compatible chat endpoint, no real API call by default.
# LLM_URL=https://your-provider.example/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=
# If changing extraction method/model/prompt, change the version on all workers.
ANALYSIS_VERSION=claims-v2-semantics
# Each analysis instance needs a separate local health listener.
ANALYSIS_HEALTH_ADDR=127.0.0.1:19191
AGENT_MAX_MODEL_CALLS=4
AGENT_MAX_TOOL_CALLS=8
AGENT_DEADLINE_SECONDS=35
AGENT_TOOL_TIMEOUT_SECONDS=8
WORKER_METRICS_ADDR=127.0.0.1:18081
# Full deterministic ranking configuration (JSON; every weight is required):
# RANKING_WEIGHTS={"status":30,"eligibility":30,"city":10,"type":5,"go_fit":10,"role":10,"freshness":5}

# Compose activation only: use a fresh Redis namespace when selecting a restored copy.
# CAMPUS_DATABASE=campustrace
CAMPUS_REDIS_PREFIX=ct:

# Optional Search: disabled unless SEARCH_URL is set. Separate read/write tokens.
# API requires only the query token; Worker needs both. Search runs separately.
# SEARCH_URL=http://127.0.0.1:18083
# SEARCH_QUERY_TOKEN=local-search-query-token-change-me-2027
# SEARCH_WRITE_TOKEN=local-search-write-token-change-me-2027
# Search process only:
# OPENSEARCH_URL=http://127.0.0.1:9200
# SEARCH_INDEX_ALIAS=campustrace-jobs-v1

# Optional Kafka job events. API + Worker must use the same mode.
# Compose overlay supplies internal addresses; host-run development examples:
JOB_EVENTS_MODE=direct
# KAFKA_BROKERS=127.0.0.1:9092
# KAFKA_JOB_TOPIC=campustrace.jobs.v1
# KAFKA_DLQ_TOPIC=campustrace.jobs.dlq.v1
# KAFKA_SEARCH_GROUP=campustrace-search-v1
# KAFKA_NOTIFY_GROUP=campustrace-notify-v1
# NOTIFY_METRICS_ADDR=127.0.0.1:18084

# Search query isolation: separate from index writes/status. Invalid values fail startup.
# Allowed query timeout: 20..1500ms; reserve: 20..1000ms; sum <= 1500ms.
SEARCH_QUERY_TIMEOUT_MS=200
SEARCH_FALLBACK_RESERVE_MS=150
